# Copy to `.env` and fill in before `docker compose up -d --build`.

# Connection string for the shared self-hosted Postgres instance.
# Use a dedicated database + credentials for Aiportal (same pattern as
# pf-cwh / tasktracker — independent account, shared host).
DATABASE_URL=postgres://aiportal_user:CHANGE_ME@postgres-host:5432/aiportal

# Admin password for the portal's admin panel and private-site unlock.
# The source falls back to a hardcoded default (85097110) if this is unset —
# always set a real value in production.
ADMIN_PASSWORD=CHANGE_ME

# Host port the portal is published on (nginx container listens on 80 inside).
HOST_PORT=3000

# Optional: overrides for the system-overview dashboard's subsystem sources
# (artifacts/api-server/src/lib/summarySources.ts). Only needed if a source
# isn't reachable at its default URL.
# PF_CWH_SUMMARY_URL=https://cwh2023.synology.me/pf/api/public/summary
# FITNESSFORGE_SUMMARY_URL=https://cwh2023.synology.me/fitness/api/public/summary

# Vikunja is a third-party app (no /api/public/summary route to add), so
# Aiportal calls its REST API directly with a dedicated read-only token
# (Settings -> API Tokens in the Vikunja web UI; grant only tasks:read_one,
# tasks:read_all, projects:read_all).
VIKUNJA_API_BASE_URL=CHANGE_ME
VIKUNJA_API_TOKEN=CHANGE_ME

# 心智指標 (mind-index) needs the api-server container to have a NAS share
# mounted at /mnt/knowledge, read-only — see the `volumes:` entry on the
# api-server service in docker-compose.yml. MIND_INDEX_PATH/
# MIND_INDEX_HISTORY_PATH are hardcoded there (not .env-configurable) since
# they're a fixed container-internal path, not a secret; only the volume
# mount's host-side source (the actual NAS UNC path) is deploy-specific.
