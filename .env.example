# Copy to `.env` and fill in before `docker compose up -d --build`.

# Connection string for the shared self-hosted Postgres instance.
# Use a dedicated database + credentials for Aiportal (same pattern as
# pf-cwh / tasktracker — independent account, shared host).
DATABASE_URL=postgres://aiportal_user:CHANGE_ME@postgres-host:5432/aiportal

# Admin password for the portal's admin panel and private-site unlock.
# Required — the server now refuses to start if this is unset or left at the
# old hardcoded-fallback placeholder value (85097110), instead of silently
# booting with a weak password. Set a real secret.
ADMIN_PASSWORD=CHANGE_ME

# Host port the portal is published on (nginx container listens on 80 inside).
HOST_PORT=3000

# Optional: overrides for the system-overview dashboard's subsystem sources
# (artifacts/api-server/src/lib/summarySources.ts). Only needed if a source
# isn't reachable at its default URL.
# PF_CWH_SUMMARY_URL=https://cwh2023.synology.me/pf/api/public/summary
# FITNESSFORGE_SUMMARY_URL=https://cwh2023.synology.me/fitness/api/public/summary

# Vikunja is a third-party app (no /api/public/summary route to add), so
# Aiportal calls its REST API directly with a dedicated read-only token
# (Settings -> API Tokens in the Vikunja web UI; grant only tasks:read_one,
# tasks:read_all, projects:read_all).
VIKUNJA_API_BASE_URL=CHANGE_ME
VIKUNJA_API_TOKEN=CHANGE_ME

# 心智指標 (mind-index) needs no volume mount / env var here — HERMES's
# daily-life-score.py POSTs the daily values to /api/admin/mind-index
# (authenticated with ADMIN_PASSWORD above), api-server just reads what's in
# Postgres. No NAS access from inside the container at all.

# 旅遊生活 (travel index) — self-hosted AdventureLog instance. API key is
# generated in AdventureLog's own settings UI (Settings -> API Keys),
# `Authorization: Api-Key <token>` header, read-only is sufficient.
ADVENTURELOG_API_BASE_URL=https://adventure.cwh2023.synology.me
ADVENTURELOG_API_TOKEN=CHANGE_ME

# Optional: push notification when a HERMES container/scheduled task/pipeline
# layer starts or stops alerting (see lib/notify.ts) — only fires on the
# false->true / true->false transition, not on every ~10-min collect.ps1
# push. Leave unset to skip notifications entirely (nothing breaks). Get a
# topic URL from https://ntfy.sh (pick any unguessable topic name) or point
# it at a self-hosted ntfy server; either way this is a bare
# `POST <url>` with the message as the body, no auth token needed for a
# public ntfy.sh topic.
# NTFY_TOPIC_URL=https://ntfy.sh/CHANGE_ME-pick-an-unguessable-topic-name
