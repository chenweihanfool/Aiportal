# Copy to `.env` in this same directory. Loaded automatically by
# compute_daily.py / snapshot.py / integration_check.py via python-dotenv —
# no need to export these in the shell/Task Scheduler environment yourself.

VIKUNJA_URL=CHANGE_ME
VIKUNJA_TOKEN=CHANGE_ME

# Aiportal's shared self-hosted Postgres (same instance the dashboard reads
# from) — busyness_index_history lives there, created automatically on
# first run.
DATABASE_URL=CHANGE_ME
