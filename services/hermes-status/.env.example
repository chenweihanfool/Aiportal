# Copy to `.env` in this same directory (gitignored). Loaded by collect.ps1
# via a small manual parser (Windows PowerShell 5.1 has no built-in dotenv).

# Same admin secret as Aiportal's own ADMIN_PASSWORD (artifacts/api-server's
# .env) -- the x-admin-password header these requests send must match it.
ADMIN_PASSWORD=CHANGE_ME

# Public HTTPS URL, not an internal Docker hostname -- this script runs
# directly on the Windows host (not inside a container), so it hits Aiportal
# the same way any external client would, same as HERMES's mind-index push.
API_BASE_URL=https://cwh2023.synology.me/aiportal

# HERMES <-> Claude control channel (see control-channel/README.md) --
# poll-control-pr.ps1 uses these, collect.ps1 ignores them. GITHUB_REPO is
# a dedicated throwaway repo (NOT this Aiportal repo) that holds nothing
# but the never-merged control PR -- keeps the PAT's blast radius off the
# real codebase. Fine-grained GitHub PAT scoped to just that repo,
# Pull requests + Issues: Read and write (PR comments live under the
# Issues API even for a PR).
GITHUB_PAT=CHANGE_ME
GITHUB_REPO=chenweihanfool/hermes-control-channel
CONTROL_PR_NUMBER=CHANGE_ME
