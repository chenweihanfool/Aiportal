{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "hermes-reports feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computedAt",
    "reports"
  ],
  "properties": {
    "computedAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "reports": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "date",
          "bodyMd",
          "createdAt"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,30}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "bodyMd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "createdAt": {
            "type": "string",
            "minLength": 10,
            "maxLength": 40
          }
        }
      }
    }
  }
}
