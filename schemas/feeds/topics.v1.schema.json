{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topics feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computedAt",
    "total",
    "published",
    "topics"
  ],
  "properties": {
    "computedAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "published": {
      "type": "integer",
      "minimum": 0
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "branches"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "branches": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "topics"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "topics": {
                      "type": "array",
                      "maxItems": 300,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "why",
          "firstSeen",
          "revision",
          "docs",
          "newDocs",
          "monthsSpan",
          "body",
          "growth",
          "sources",
          "related"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "concept",
              "method"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 200
          },
          "firstSeen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lastSeen": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updated": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "docs": {
            "type": "integer",
            "minimum": 0
          },
          "newDocs": {
            "type": "integer",
            "minimum": 0
          },
          "monthsSpan": {
            "type": "integer",
            "minimum": 0
          },
          "firstMonth": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "lastMonth": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "path": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "monthCounts": {
            "type": "array",
            "maxItems": 36,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "month",
                "count"
              ],
              "properties": {
                "month": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "body": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 13000
          },
          "growth": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "text"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "month": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}$"
                }
              }
            }
          },
          "related": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "sharedDocs": {
                  "type": "integer",
                  "minimum": 0
                },
                "sharedCases": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
