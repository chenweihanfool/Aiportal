{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topics feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computedAt",
    "total",
    "published",
    "topics"
  ],
  "properties": {
    "computedAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "published": {
      "type": "integer",
      "minimum": 0
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domains"
      ],
      "properties": {
        "domains": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "branches"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "name": {
                "type": "string",
                "maxLength": 40
              },
              "branches": {
                "type": "array",
                "maxItems": 40,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "name",
                    "topics"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "topics": {
                      "type": "array",
                      "maxItems": 300,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "why",
          "firstSeen",
          "revision",
          "docs",
          "newDocs",
          "monthsSpan",
          "body",
          "growth",
          "sources",
          "related"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "enum": [
              "concept",
              "method"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 200
          },
          "firstSeen": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lastSeen": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "updated": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "docs": {
            "type": "integer",
            "minimum": 0
          },
          "newDocs": {
            "type": "integer",
            "minimum": 0
          },
          "monthsSpan": {
            "type": "integer",
            "minimum": 0
          },
          "firstMonth": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "lastMonth": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 40
          },
          "path": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          },
          "monthCounts": {
            "type": "array",
            "maxItems": 36,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "month",
                "count"
              ],
              "properties": {
                "month": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "body": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 13000
          },
          "growth": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "text"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "text": {
                  "type": "string",
                  "maxLength": 300
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "month": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}$"
                },
                "type": {
                  "enum": [
                    "pdf",
                    "word",
                    "excel",
                    "image",
                    "text",
                    "diary",
                    "note",
                    "event",
                    "other"
                  ]
                },
                "case": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 60
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          },
          "related": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "sharedDocs": {
                  "type": "integer",
                  "minimum": 0
                },
                "sharedCases": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "diagram": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "version",
                  "lanes",
                  "phases",
                  "nodes",
                  "edges"
                ],
                "properties": {
                  "type": {
                    "const": "flow"
                  },
                  "version": {
                    "const": 1
                  },
                  "lanes": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8
                    }
                  },
                  "phases": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8
                    }
                  },
                  "nodes": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label",
                        "src",
                        "lane",
                        "phase",
                        "shape"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 14
                        },
                        "sub": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 24
                        },
                        "src": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "unknown": {
                          "type": "boolean"
                        },
                        "ai": {
                          "type": "boolean"
                        },
                        "note": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 120
                        },
                        "lane": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "phase": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "shape": {
                          "enum": [
                            "step",
                            "decision"
                          ]
                        },
                        "pitfall": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "edges": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from",
                        "to"
                      ],
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 10
                        },
                        "back": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "version",
                  "tracks",
                  "items"
                ],
                "properties": {
                  "type": {
                    "const": "timeline"
                  },
                  "version": {
                    "const": 1
                  },
                  "tracks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 8
                        }
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 80,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "track",
                        "date",
                        "label",
                        "src"
                      ],
                      "properties": {
                        "track": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "date": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "end": {
                          "type": "string",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 14
                        },
                        "src": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "sub": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 24
                        },
                        "note": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 120
                        },
                        "ai": {
                          "type": "boolean"
                        },
                        "unknown": {
                          "type": "boolean"
                        }
                      }
                    }
                  },
                  "metrics": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 2,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "points"
                      ],
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 10
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 6
                        },
                        "points": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 40,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "date",
                              "value",
                              "src"
                            ],
                            "properties": {
                              "date": {
                                "type": "string",
                                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                              },
                              "value": {
                                "type": "number"
                              },
                              "src": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 6,
                                "items": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "version",
                  "core",
                  "observations",
                  "frameworks",
                  "judgments",
                  "links"
                ],
                "properties": {
                  "type": {
                    "const": "map"
                  },
                  "version": {
                    "const": 1
                  },
                  "core": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  },
                  "observations": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label",
                        "src"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 14
                        },
                        "sub": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 24
                        },
                        "src": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "unknown": {
                          "type": "boolean"
                        },
                        "ai": {
                          "type": "boolean"
                        },
                        "note": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 120
                        }
                      }
                    }
                  },
                  "frameworks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label",
                        "src"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 14
                        },
                        "sub": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 24
                        },
                        "src": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "unknown": {
                          "type": "boolean"
                        },
                        "ai": {
                          "type": "boolean"
                        },
                        "note": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 120
                        }
                      }
                    }
                  },
                  "judgments": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "label",
                        "src"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 14
                        },
                        "sub": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 24
                        },
                        "src": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "integer",
                            "minimum": 1
                          }
                        },
                        "unknown": {
                          "type": "boolean"
                        },
                        "ai": {
                          "type": "boolean"
                        },
                        "note": {
                          "type": "string",
                          "minLength": 0,
                          "maxLength": 120
                        }
                      }
                    }
                  },
                  "links": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 60,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from",
                        "to"
                      ],
                      "properties": {
                        "from": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        },
                        "to": {
                          "type": "string",
                          "pattern": "^[a-z0-9]{1,8}$"
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "claims": {
            "type": "array",
            "maxItems": 300,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "section",
                "status",
                "origin",
                "pinned",
                "firstSeen",
                "lastChanged",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^c[0-9]{3,5}$"
                },
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "disputed"
                  ]
                },
                "origin": {
                  "type": "string",
                  "enum": [
                    "model",
                    "user"
                  ]
                },
                "pinned": {
                  "type": "boolean"
                },
                "firstSeen": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "lastChanged": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "claimStats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "active",
              "retired",
              "disputed",
              "user"
            ],
            "properties": {
              "active": {
                "type": "integer",
                "minimum": 0
              },
              "retired": {
                "type": "integer",
                "minimum": 0
              },
              "disputed": {
                "type": "integer",
                "minimum": 0
              },
              "user": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "appliedCorrections": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
