{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "companion feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computedAt",
    "date",
    "onThisDay",
    "quietPeople",
    "socialDays"
  ],
  "properties": {
    "computedAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "onThisDay": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "title"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "event",
              "report"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "quietPeople": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "lastDate",
          "daysQuiet",
          "events"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "lastDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "daysQuiet": {
            "type": "integer",
            "minimum": 0
          },
          "events": {
            "type": "integer",
            "minimum": 1
          },
          "lastEvent": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 120
          },
          "usualGapDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 3650
          },
          "overdue": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    },
    "socialDays": {
      "type": "array",
      "maxItems": 130,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "people"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "people": {
            "type": "integer",
            "minimum": 1
          },
          "names": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "types": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "face_to_face",
              "call",
              "text"
            ],
            "properties": {
              "face_to_face": {
                "type": "integer",
                "minimum": 0
              },
              "call": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
