{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "topic-nudges feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "computedAt",
    "date",
    "matches",
    "recall"
  ],
  "properties": {
    "computedAt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 40
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "matches": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "forDate",
          "topicId",
          "name",
          "path",
          "published",
          "point",
          "triggers",
          "score"
        ],
        "properties": {
          "forDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "topicId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "path": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "published": {
            "type": "boolean"
          },
          "point": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "title",
                "due"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "task",
                    "diary"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "due": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "matchedBy": {
            "enum": [
              "case",
              "terms"
            ]
          },
          "caseName": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "recall": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topicId",
          "name",
          "path",
          "published",
          "point",
          "reason",
          "lastMonth",
          "years"
        ],
        "properties": {
          "topicId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "path": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "published": {
            "type": "boolean"
          },
          "point": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "lastMonth": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "years": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            }
          }
        }
      }
    },
    "resumes": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "forDate",
          "at",
          "caseName",
          "quietDays",
          "why",
          "events"
        ],
        "properties": {
          "forDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "caseName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "quietDays": {
            "type": "integer",
            "minimum": 0
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "events": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "title"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              }
            }
          }
        }
      }
    }
  }
}
